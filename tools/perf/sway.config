# sway configuration of the invisible desktop: one headless output at
# 240 Hz, no bar, no borders, no gaps, no background program, no Xwayland
# (the apps are measured as native Wayland clients, D5). The only window is
# the measured app, which fills the output.
output HEADLESS-1 mode --custom 1920x1080@240Hz position 0 0 scale 1
swaybg_command -
default_border none
default_floating_border none
titlebar_border_thickness 0
titlebar_padding 1
gaps inner 0
gaps outer 0
focus_on_window_activation focus
focus_follows_mouse no
xwayland disable
seat * hide_cursor 0

exec /bench/tools/inner.sh
